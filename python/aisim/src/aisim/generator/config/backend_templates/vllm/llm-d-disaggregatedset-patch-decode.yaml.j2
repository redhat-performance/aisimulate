{#
JSON 6902 patch for the decode role of the llm-d v1.0+ `DisaggregatedSet`.
See llm-d-disaggregatedset-kustomization.yaml.j2 for why this is JSON 6902 and
why the first op is a `test`.
#}
{%- set service_config = ServiceConfig | default({}) -%}
{%- set llmd_config = LlmdConfig | default({}) -%}
{%- set node_config = NodeConfig | default({}) -%}
{%- set model_name = service_config.model_path | default('meta-llama/Llama-3.1-8B') -%}
{%- set served_name = service_config.served_model_name | default(model_name.split('/')[-1], true) -%}
{%- set role_workers = decode_workers | default(1) -%}
{#- Prefer the rule-derived count: it is the one topology the args encode, and
    it keeps the pod request in step with any knob a parallel-size product
    misses (for example decode CP, which reuses attention ranks and adds no
    GPUs, so the fallback product stays TP x PP x DP). -#}
{%- set role_gpu_fallback = (decode_tensor_parallel_size | default(1) | int) * (decode_pipeline_parallel_size | default(1) | int) * (decode_data_parallel_size | default(1) | int) -%}
{%- set role_gpu = decode_gpu | default(role_gpu_fallback, true) -%}
{%- set role_cli_args = decode_cli_args_list | default([]) -%}
{%- set default_accelerator_type = 'xpu' if node_config.system_name | default('') == 'b60' else 'nvidia' -%}
{%- set accelerator_type = llmd_config.accelerator_type | default(default_accelerator_type, true) -%}
{%- set is_xpu = accelerator_type in ['xpu', 'intel'] -%}
{%- set xpu_rdma_enabled = llmd_config.xpu_rdma_enabled | default(false) -%}
{%- set xpu_kv_buffer_device = llmd_config.xpu_kv_buffer_device | default('xpu' if xpu_rdma_enabled else 'cpu', true) -%}
{%- if is_xpu -%}
{%- set kv_transfer_config = '{"kv_connector":"NixlConnector","kv_role":"kv_consumer","kv_buffer_device":"' ~ xpu_kv_buffer_device ~ '"}' -%}
{%- else -%}
{%- set kv_transfer_config = '{"kv_connector":"NixlConnector","kv_role":"kv_consumer","kv_buffer_device":"cuda","kv_connector_extra_config":{"backends":["UCX"]}}' -%}
{%- endif -%}
- op: test
  path: /spec/roles/1/name
  value: decode
- op: replace
  path: /spec/roles/1/spec/replicas
  value: {{ role_workers }}
- op: replace
  path: /spec/roles/1/spec/leaderWorkerTemplate/workerTemplate/spec/containers/0/image
  value: {{ llmd_config.vllm_image | default('vllm/vllm-openai:latest') | tojson }}
- op: replace
  path: /spec/roles/1/spec/leaderWorkerTemplate/workerTemplate/spec/containers/0/args
  value:
    - {{ model_name | tojson }}
    - --served-model-name
    - {{ served_name | tojson }}
    {% for arg in role_cli_args %}
    - {{ arg | tojson }}
    {% endfor %}
    {% if '--kv-transfer-config' not in role_cli_args %}
    - --kv-transfer-config
    - {{ kv_transfer_config | tojson }}
    {% endif %}
    {% if '--port' not in role_cli_args and '--port=8200' not in role_cli_args %}
    - --port=8200
    {% endif %}
{% if not is_xpu %}
{#- `add` on the GPU entries keeps the base's cpu/memory requests and limits.
    `~1` escapes the `/` in the resource name (RFC 6901). -#}
- op: add
  path: /spec/roles/1/spec/leaderWorkerTemplate/workerTemplate/spec/containers/0/resources/limits/nvidia.com~1gpu
  value: "{{ role_gpu }}"
- op: add
  path: /spec/roles/1/spec/leaderWorkerTemplate/workerTemplate/spec/containers/0/resources/requests/nvidia.com~1gpu
  value: "{{ role_gpu }}"
{% endif %}
